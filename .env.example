# Copy to .env.local for local development, and set the same three values in
# Hostinger's environment-variable panel for production.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where loan applications are delivered. Comma-separate for multiple recipients.
APPLICATION_TO_EMAIL=lewis@mcknight.com

# Sender address. Must be on a domain verified in Resend.
# Before verifying a domain, use onboarding@resend.dev (only delivers to the
# email on your own Resend account).
APPLICATION_FROM_EMAIL=loans@lazydogcapital.com

# Sender for the confirmation sent back to the person who filled in a form.
# Falls back to APPLICATION_FROM_EMAIL, then loans@lazydogcapital.com.
# Replies to it go to APPLICATION_TO_EMAIL, so make it a real monitored mailbox.
AUTOREPLY_FROM_EMAIL=loans@lazydogcapital.com

# Internal document library at /library. Basic Auth — pick a long passphrase.
# Without these set the library returns 503 rather than opening to everyone.
LIBRARY_USER=lazydog
LIBRARY_PASS=change-me-to-something-long
